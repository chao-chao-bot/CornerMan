# CornerMan · 环境变量示例
# 复制到根目录 .env 后按需修改

# ---------- 数据库 ----------
# 宿主机端口用 5433，避免与本机自带 postgres(5432) 冲突（见 infra/docker-compose.yml）
DATABASE_URL=postgresql://cornerman:cornerman@localhost:5433/cornerman

# ---------- Redis / BullMQ ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ---------- 对象存储（本地 MinIO 替代阿里云 OSS）----------
OSS_ENDPOINT=http://localhost:9000
OSS_REGION=cn-hangzhou
OSS_BUCKET=cornerman
OSS_ACCESS_KEY_ID=cornerman
OSS_ACCESS_KEY_SECRET=cornerman123
# STS 直传（生产使用）
OSS_STS_ROLE_ARN=
OSS_STS_DURATION=3600

# ---------- 鉴权（JWT）----------
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---------- LLM（通义千问-VL）----------
DASHSCOPE_API_KEY=
QWEN_VL_MODEL=qwen-vl-max

# ---------- 服务端口 ----------
API_PORT=4000
WEB_PORT=3000
AI_SERVICE_PORT=5000
AI_SERVICE_URL=http://localhost:5000
