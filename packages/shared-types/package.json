{
  "name": "@cornerman/shared-types",
  "version": "0.0.0",
  "private": true,
  "description": "跨端共享 TypeScript 类型（实体 / DTO / 枚举）",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
