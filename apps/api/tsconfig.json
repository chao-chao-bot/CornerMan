{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "ES2021",
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false,
    "declaration": false,
    "isolatedModules": false,
    "paths": {}
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
